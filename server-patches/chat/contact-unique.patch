+
+// Pending registrations reserve a phone before creating an account. Failed requests
+// release it; the TTL only recovers reservations if the process stops unexpectedly.
+func (o *Api) initContactIndexes(ctx context.Context) error {
+	_, err := o.contacts.UpdateMany(ctx, bson.M{"userID": bson.M{"$exists": false}}, mongo.Pipeline{{{Key: "$set", Value: bson.M{"userID": "$_id"}}}})
+	if err != nil {
+		return err
+	}
+	_, err = o.contacts.Indexes().CreateMany(ctx, []mongo.IndexModel{
+		{Keys: bson.D{{Key: "userID", Value: 1}}, Options: options.Index().SetUnique(true).SetPartialFilterExpression(bson.M{"userID": bson.M{"$gt": ""}})},
+		{Keys: bson.D{{Key: "areaCode", Value: 1}, {Key: "phoneNumber", Value: 1}}, Options: options.Index().SetUnique(true).SetPartialFilterExpression(bson.M{"phoneNumber": bson.M{"$gt": ""}})},
+		{Keys: bson.D{{Key: "expiresAt", Value: 1}}, Options: options.Index().SetExpireAfterSeconds(0)},
+	})
+	return err
+}
+
+func normalizeContact(profile *contactProfile) error {
+	profile.PhoneNumber = strings.TrimSpace(profile.PhoneNumber)
+	profile.AreaCode = strings.TrimSpace(profile.AreaCode)
+	if !areaPattern.MatchString(profile.AreaCode) || (profile.PhoneNumber != "" && !phonePattern.MatchString(profile.PhoneNumber)) {
+		return errs.ErrArgs.WrapMsg("Invalid phone number or area code")
+	}
+	code, _ := strconv.Atoi(profile.AreaCode[1:])
+	profile.AreaCode = "+" + strconv.Itoa(code)
+	return nil
+}
+
+func (o *Api) checkNativePhone(ctx context.Context, profile contactProfile, userID string) error {
+	if profile.PhoneNumber == "" {
+		return nil
+	}
+	resp, err := o.chatClient.CheckUserExist(ctx, &chatpb.CheckUserExistReq{User: &chatpb.RegisterUserInfo{AreaCode: profile.AreaCode, PhoneNumber: profile.PhoneNumber}})
+	if err != nil {
+		return err
+	}
+	if resp.IsRegistered && resp.Userid != userID {
+		return eerrs.ErrPhoneAlreadyRegister.Wrap()
+	}
+	return nil
+}
+
+func (o *Api) reserveContact(ctx context.Context, profile contactProfile) (primitive.ObjectID, error) {
+	if err := normalizeContact(&profile); err != nil {
+		return primitive.NilObjectID, err
+	}
+	if err := o.checkNativePhone(ctx, profile, ""); err != nil {
+		return primitive.NilObjectID, err
+	}
+	id := primitive.NewObjectID()
+	_, err := o.contacts.InsertOne(ctx, bson.M{"_id": id, "userID": "", "areaCode": profile.AreaCode, "phoneNumber": profile.PhoneNumber, "expiresAt": time.Now().Add(15 * time.Minute)})
+	if mongo.IsDuplicateKeyError(err) {
+		err = eerrs.ErrPhoneAlreadyRegister.Wrap()
+	}
+	return id, err
+}
