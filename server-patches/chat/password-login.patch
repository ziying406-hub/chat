new file mode 100644
--- /dev/null
+++ b/internal/rpc/chat/login_password.go
@@ -0,0 +1,16 @@
+package chat
+
+import (
+	"crypto/md5"
+	"encoding/hex"
+)
+
+// The official admin stores MD5 passwords; 99chat signup stores raw passwords.
+// Preserve the native hash protocol and accept 99chat's raw login input for both.
+func matchesLoginPassword(stored, input string) bool {
+	if stored == input {
+		return true
+	}
+	sum := md5.Sum([]byte(input))
+	return stored == hex.EncodeToString(sum[:])
+}
diff --git a/internal/rpc/chat/login_password_test.go b/internal/rpc/chat/login_password_test.go
new file mode 100644
--- /dev/null
+++ b/internal/rpc/chat/login_password_test.go
@@ -0,0 +1,25 @@
+package chat
+
+import "testing"
+
+func TestMatchesLoginPassword(t *testing.T) {
+	const raw = "admin-created-password"
+	const hashed = "b8571953b30913dd3e8ecd3032f5f9f9"
+	cases := []struct {
+		name, stored, input string
+		want                bool
+	}{
+		{"99chat signup", raw, raw, true},
+		{"admin created", hashed, raw, true},
+		{"native SDK", hashed, hashed, true},
+		{"wrong password", hashed, "incorrect-password", false},
+		{"wrong raw password", raw, "incorrect-password", false},
+	}
+	for _, tt := range cases {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := matchesLoginPassword(tt.stored, tt.input); got != tt.want {
+				t.Fatalf("password match = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
