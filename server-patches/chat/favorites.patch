@@ -48,6 +52,71 @@ type Api struct {
 	chatClient  chatpb.ChatClient
 	adminClient admin.AdminClient
 	imApiCaller imapi.CallerInterface
+	favorites   *mongo.Collection
+}
+
+type favorite struct {
+	UserID      string `bson:"userID" json:"-"`
+	ClientMsgID string `bson:"clientMsgID" json:"clientMsgID"`
+	SendID      string `bson:"sendID" json:"sendID"`
+	SenderName  string `bson:"senderName" json:"senderName"`
+	Content     string `bson:"content" json:"content"`
+	ContentType int32  `bson:"contentType" json:"contentType"`
+	Time        int64  `bson:"time" json:"time"`
+	Kind        string `bson:"kind" json:"kind"`
+	MediaURL    string `bson:"mediaURL" json:"mediaUrl"`
+	Duration    int32  `bson:"duration" json:"duration"`
+	FileName    string `bson:"fileName" json:"fileName"`
+}
+
+func (o *Api) ListFavorites(c *gin.Context) {
+	userID := mctx.GetOpUserID(c)
+	cursor, err := o.favorites.Find(c, bson.M{"userID": userID}, options.Find().SetSort(bson.D{{Key: "time", Value: -1}}))
+	if err != nil {
+		apiresp.GinError(c, err)
+		return
+	}
+	defer cursor.Close(c)
+	var items []favorite
+	if err = cursor.All(c, &items); err != nil {
+		apiresp.GinError(c, err)
+		return
+	}
+	apiresp.GinSuccess(c, items)
+}
+
+func (o *Api) SaveFavorite(c *gin.Context) {
+	var item favorite
+	if err := c.ShouldBindJSON(&item); err != nil || item.ClientMsgID == "" {
+		apiresp.GinError(c, errs.ErrArgs.WrapMsg("clientMsgID is empty"))
+		return
+	}
+	item.UserID = mctx.GetOpUserID(c)
+	if item.Time == 0 {
+		item.Time = time.Now().UnixMilli()
+	}
+	_, err := o.favorites.UpdateOne(c, bson.M{"userID": item.UserID, "clientMsgID": item.ClientMsgID}, bson.M{"$set": item}, options.Update().SetUpsert(true))
+	if err != nil {
+		apiresp.GinError(c, err)
+		return
+	}
+	apiresp.GinSuccess(c, item)
+}
+
+func (o *Api) DeleteFavorite(c *gin.Context) {
+	var req struct {
+		ClientMsgID string `json:"clientMsgID"`
+	}
+	if err := c.ShouldBindJSON(&req); err != nil || req.ClientMsgID == "" {
+		apiresp.GinError(c, errs.ErrArgs.WrapMsg("clientMsgID is empty"))
+		return
+	}
+	_, err := o.favorites.DeleteOne(c, bson.M{"userID": mctx.GetOpUserID(c), "clientMsgID": req.ClientMsgID})
+	if err != nil {
+		apiresp.GinError(c, err)
+		return
+	}
+	apiresp.GinSuccess(c, nil)
 }
 
