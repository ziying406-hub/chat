new file mode 100644
index 0000000..82a3548
--- /dev/null
+++ b/pkg/common/imapi/registration_test.go
@@ -0,0 +1,21 @@
+package imapi
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestExistingIMAccountIsNotMissing(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		w.Write([]byte(`{"errCode":0,"data":{"results":[{"userID":"existing-user","accountStatus":1}]}}`))
+	}))
+	defer server.Close()
+	caller := &Caller{imApi: server.URL}
+	missing, err := caller.AccountCheckSingle(context.Background(), "existing-user")
+	if err != nil || missing {
+		t.Fatalf("existing user must return false without error: %v, %v", missing, err)
+	}
+}
